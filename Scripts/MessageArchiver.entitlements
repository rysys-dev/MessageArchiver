<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened Runtime blocks Contacts unless the app declares it (spec §4.2). Not sandboxed:
         Full Disk Access is granted by the user in System Settings, not by an entitlement. -->
    <key>com.apple.security.personal-information.addressbook</key>
    <true/>
</dict>
</plist>
